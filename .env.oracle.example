# Copy on the Oracle VM:  cp .env.oracle.example .env  &&  nano .env
# Used with: docker compose --profile localdb -f docker-compose.yml -f docker-compose.oracle.yml

APP_ENV=production
APP_DATA_SCHEMA=app_data
POSTGIS_DSN=dbname=traffic user=postgres password=postgres host=postgis port=5432
REDIS_URL=redis://redis:6379/0

# Demo auth — no login required
REQUIRE_USER_ID=0
JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOW_ORIGINS=*

# Set after Cloudflare Tunnel is running (public https URL, no trailing slash)
OAUTH_REDIRECT_BASE=https://YOUR-TUNNEL-URL.trycloudflare.com

# Agent (pick one backend)
GOOGLE_API_KEY=
AGENT_MODEL_BACKEND=google
AGENT_MODEL_DEFAULT=gemini-2.5-flash
# AGENT_MODEL_BACKEND=litellm
# AGENT_MODEL_DEFAULT=openrouter/openai/gpt-5-mini
# AGENT_LITELLM_API_KEY=

AGENT_SKILLS_ENABLED=1
DEFAULT_CV_DATASET=iowa_cv_winter_2025
CRASH_TIMEZONE=America/Chicago
CLEAR_POSTGIS_ON_STARTUP=0
CLEAR_POSTGIS_ON_SHUTDOWN=0

# Frontend build (rebuild web image after changes)
VITE_MAPBOX_TOKEN=
VITE_API_BASE_URL=
VITE_TILE_API_BASE_URL=
VITE_USE_ROAD_TILES=1
VITE_ROAD_TILES_DATASET=iowa_cv_winter_2025

APP_API_WORKERS=2
TILE_API_WORKERS=1
