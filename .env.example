# Local development template. Copy to .env and fill in secrets.
# Do not commit real keys or passwords.

APP_ENV=development
APP_DATA_SCHEMA=app_data

# For Docker localdb profile:
POSTGIS_DSN=dbname=traffic user=postgres password=postgres host=postgis port=5432

# For an external DB, replace POSTGIS_DSN, for example:
# POSTGIS_DSN=postgresql://postgres:postgres@host.docker.internal:5433/traffic

REDIS_URL=redis://redis:6379/0

# Required for agent chat.
GOOGLE_API_KEY=
AGENT_MODEL_BACKEND=google
AGENT_MODEL_DEFAULT=gemini-2.5-flash

# Optional OpenRouter/LiteLLM mode.
# AGENT_MODEL_BACKEND=litellm
# AGENT_MODEL_DEFAULT=openrouter/openai/gpt-5-mini
# OPENROUTER_API_KEY=
# AGENT_LITELLM_API_KEY=

# Local auth/security.
# Set REQUIRE_USER_ID=0 for local deployment (matches frontend no-auth dev mode).
JWT_SECRET=dev-insecure-jwt-secret-change-me
REQUIRE_USER_ID=0
ALLOW_DEBUG_USER_HEADER=0
CORS_ALLOW_ORIGINS=*
OAUTH_REDIRECT_BASE=http://localhost:8080

# Optional OAuth. Local email/password auth works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend build variables. Rebuild the web image after changing these.
VITE_MAPBOX_TOKEN=
VITE_API_BASE_URL=
VITE_TILE_API_BASE_URL=
VITE_USE_ROAD_TILES=0
VITE_ROAD_TILES_DATASET=
VITE_ENABLE_WEBSITE_BUILDER_ROUTES=0
VITE_ENABLE_CHART_EDITING=0

# Analysis/runtime tuning.
CRASH_TIMEZONE=America/Chicago
CLEAR_POSTGIS_ON_STARTUP=0
CLEAR_POSTGIS_ON_SHUTDOWN=0
APP_API_WORKERS=3
TILE_API_WORKERS=2
REQUEST_TIMING_LOG_ENABLED=1
REQUEST_TIMING_INCLUDE_QUERY=0
REQUEST_TIMING_ADD_HEADER=0
REQUEST_TIMING_LOG_HEALTH=0
